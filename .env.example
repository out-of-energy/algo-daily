# ---- AI ----
# DeepSeek: https://platform.deepseek.com/api_keys
AI_API_KEY=
# 也可以只给文件路径（推荐复用单词项目时使用，不会把 key 写进环境）
# AI_API_KEY_FILE=~/.config/algo-daily/deepseek-key
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-v4-flash

# 也兼容 OpenAI 或其他 OpenAI-compatible 服务：
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4.1-mini

# ---- 邮件 ----
# QQ 邮箱示例：smtp.qq.com / 465 / SSL，密码填“授权码”不是登录密码
# Gmail 示例：smtp.gmail.com / 465 / SSL，密码填 App Password
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASS=
# 也可以读取文件，避免把授权码写进环境（单词项目使用这种方案）
# SMTP_PASSWORD_FILE=~/.config/algo-daily/smtp-password
MAIL_FROM=
MAIL_TO=

# 如果网页已经部署到公网，填例如 https://your-name.github.io/algo-daily
# 留空时邮件会改为引导打开附件 HTML。
PUBLIC_BASE_URL=

# 1 = 只生成 .eml 不真的发信；0 = 配置齐全时发信
MAIL_DRY_RUN=1
